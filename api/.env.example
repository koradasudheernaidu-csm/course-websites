PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/learner_credentials?retryWrites=true&w=majority
# Format: ISSUER_ID:LONG_RANDOM_SECRET,ANOTHER_ISSUER_ID:ANOTHER_SECRET
ISSUER_API_KEYS=NPTEL-DEMO:replace_with_a_long_random_secret,ANITS-DEMO:replace_with_another_long_random_secret
# Comma-separated Vercel origins. Add your actual domains after deployment.
ALLOWED_ORIGINS=http://localhost:3000
